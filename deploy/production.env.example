# Production settings template (copy to /etc/avc/production.env, chmod 600, owned by the deploy user; never commit the
# real file). Every value marked REQUIRED must be supplied; nothing here is a working credential.
APP_ENV=production
APP_SECRET_KEY=                        # REQUIRED: 48+ random characters (openssl rand -base64 48), unique per environment
STORE_A_DATABASE_URL=postgresql://store_a_app:<password>@postgres:5432/store_a     # REQUIRED
STORE_B_DATABASE_URL=postgresql://store_b_app:<password>@postgres:5432/store_b     # REQUIRED
POSTGRES_PASSWORD=                     # REQUIRED (compose)
STORE_A_DB_PASSWORD=                   # REQUIRED (compose; must match the URL above)
STORE_B_DB_PASSWORD=                   # REQUIRED
STORE_A_DOMAIN=                        # REQUIRED e.g. shop.example.in (DNS A/AAAA record → this host)
STORE_B_DOMAIN=                        # REQUIRED
ACME_EMAIL=                            # REQUIRED: certificate expiry notices
CORS_ORIGINS=https://<store A domain>,https://<store B domain>
STORE_A_PUBLIC_URL=https://<store A domain>   # links in e-mails (password reset, order shipped)
STORE_B_PUBLIC_URL=https://<store B domain>
TRUSTED_PROXIES=                       # the Caddy container address(es), so client IPs (rate limits) are real
AUTH_COOKIES=true                      # HttpOnly + SameSite=Strict + Secure cookie sessions with CSRF protection
TOKEN_TTL_MINUTES=60
LOG_FORMAT=json
API_DOCS_ENABLED=false
PHONE_SIMULATOR_ENABLED=false
PAYMENT_PROVIDER=sandbox               # payment-provider integration is out of scope
LLM_ENABLED=false                      # true only with a reachable private Ollama host (OLLAMA_URL); never a public endpoint
SPEECH_STT=none                        # whisper_cpp needs the binary + models in the image (not included)
SPEECH_TTS=none
EMAIL_DELIVERY=none                    # smtp once a provider account and a verified sending domain exist:
# SMTP_HOST=  SMTP_PORT=587  SMTP_USERNAME=  SMTP_PASSWORD=  SMTP_FROM="Summit Trail Co. <orders@your-domain>"
UNPAID_ORDER_TTL_MINUTES=1440          # owner decision (docs/business-information.md)
STORE_A_MARKET=US
STORE_B_MARKET=US
