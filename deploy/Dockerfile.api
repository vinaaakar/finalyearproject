# API and worker image (same code; the compose file chooses the command). Non-root, no build tools at runtime.
FROM python:3.14-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY backend/requirements.txt /app/requirements.txt
RUN pip install -r /app/requirements.txt && useradd --system --uid 10001 --home /app avc
COPY backend/app /app/app
COPY backend/migrations /app/migrations
COPY scripts/dbsafety.py /app/scripts/dbsafety.py
USER avc
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=3s --retries=3 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health/live', timeout=2)"
CMD ["uvicorn", "app.main:build_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--no-proxy-headers"]  # client IPs: the app trusts X-Forwarded-For only from TRUSTED_PROXIES
