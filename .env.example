# Copy to .env (scripts/setup.sh does this and generates secrets for you).
# Never commit .env.

APP_ENV=development
# At least 32 characters. Generate: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me-to-a-long-random-string-of-48-chars
TOKEN_TTL_MINUTES=60

# Postgres superuser for the local container only
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

# One database AND one database role per store. Each role can only connect to its own database.
STORE_A_DB_PASSWORD=change-me-a
STORE_B_DB_PASSWORD=change-me-b
STORE_A_DATABASE_URL=postgresql://store_a_app:change-me-a@127.0.0.1:5433/store_a
STORE_B_DATABASE_URL=postgresql://store_b_app:change-me-b@127.0.0.1:5433/store_b

# Local AI (Ollama). Set LLM_ENABLED=false to force deterministic replies.
LLM_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=45

# Comma-separated storefront origins allowed to call the API directly
CORS_ORIGINS=http://localhost:5180,http://localhost:5181,http://127.0.0.1:5180,http://127.0.0.1:5181

# Requests per minute per client IP
RATE_LIMIT_CHAT_PER_MIN=30
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_DEFAULT_PER_MIN=120

# Phone: map dialed numbers (E.164) to stores for real providers
PHONE_NUMBER_STORE_MAP=+15550100001=store-a,+15550100002=store-b

# Payments. Only the SANDBOX provider exists: no real money moves and no card data is collected.
# A live provider must be implemented and explicitly authorised before it can be enabled.
PAYMENT_PROVIDER=sandbox
# PAYMENT_LIVE_AUTHORIZED=false

# Accounts
PASSWORD_RESET_TTL_MINUTES=30
# dev_outbox writes password-reset emails to .run/outbox/ (development only); none disables sending.
EMAIL_DELIVERY=dev_outbox
# Used to build links in emails (e.g. password reset)
STORE_A_PUBLIC_URL=http://127.0.0.1:5180
STORE_B_PUBLIC_URL=http://127.0.0.1:5181

# Local speech (optional; both run on this machine). Browser speech is used when these are off.
# STT: whisper.cpp. Needs `whisper-cli` (brew install whisper-cpp) and a ggml model, e.g. ggml-base.en.bin (~142 MB).
SPEECH_STT=none
# SPEECH_STT=whisper_cpp
# WHISPER_CPP_BIN=whisper-cli
# WHISPER_MODEL_PATH=/absolute/path/to/ggml-base.en.bin
# TTS: macOS built-in `say` (no download).
SPEECH_TTS=none
# SPEECH_TTS=macos_say
# TTS_VOICE=Samantha
# Voice languages (server STT needs a MULTILINGUAL model such as ggml-base.bin for ta/hi; *.en models are English-only).
# SPEECH_LANGUAGES=ta,en,hi
# SPEECH_DEFAULT_LANGUAGE=ta          # Tamil by default; used when detection is unsure, and by the browser recognizer
# SPEECH_LANGUAGE_DETECTION=auto      # auto | off
# WHISPER_EN_MODEL_PATH=/absolute/path/to/ggml-base.en.bin   # optional, more accurate English
# Server speech voices per language (macOS `say`; must be installed — checked at runtime)
# TTS_VOICE=Rishi          # English (en-IN); default Samantha
# TTS_VOICE_TA=Vani
# TTS_VOICE_HI=Lekha
